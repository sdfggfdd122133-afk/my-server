```css
/* =========================================================
   IDEA DASHBOARD
   Arabic RTL — Cairo
========================================================= */

/* 1. استيراد خط Cairo العربي من Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap');


/* =========================================================
   GLOBAL
========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Cairo', sans-serif !important;

    background:
        radial-gradient(
            circle at top right,
            rgba(37, 99, 235, 0.12),
            transparent 35%
        ),
        #020817;

    color: #fff;

    margin: 0;

    direction: rtl;

    min-height: 100vh;

    overflow-x: hidden;
}


/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: #020817;
}

::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
    background: #3b82f6;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {

    background:
        linear-gradient(
            180deg,
            #1e293b 0%,
            #0f172a 100%
        ) !important;

    box-shadow:
        4px 0 25px
        rgba(0, 0, 0, 0.35);

    transition:
        all 0.3s ease;

    border-left:
        1px solid
        rgba(148, 163, 184, 0.08);

}


/* =========================================================
   SIDEBAR BRAND
========================================================= */

.sidebar .brand {

    font-weight: 900;

    letter-spacing: 3px;

    color: #60a5fa;

    text-shadow:
        0 0 20px
        rgba(59, 130, 246, 0.35);

}


/* =========================================================
   SIDEBAR NAVIGATION
========================================================= */

.sidebar .nav-link {

    font-weight: 500;

    padding:
        12px 20px;

    border-radius:
        8px;

    margin-bottom:
        5px;

    color:
        #cbd5e1;

    transition:
        all 0.2s ease-in-out;

    position: relative;

    overflow: hidden;

}


.sidebar .nav-link::before {

    content: '';

    position: absolute;

    right: 0;

    top: 0;

    width: 3px;

    height: 100%;

    background: #60a5fa;

    transform:
        scaleY(0);

    transition:
        transform 0.25s ease;

}


.sidebar .nav-link:hover {

    background-color:
        rgba(255, 255, 255, 0.08) !important;

    color:
        #60a5fa !important;

    transform:
        translateX(-5px);

}


.sidebar .nav-link:hover::before {

    transform:
        scaleY(1);

}


/* الرابط النشط */

.sidebar .nav-link.active {

    background:
        linear-gradient(
            90deg,
            rgba(59, 130, 246, 0.18),
            rgba(59, 130, 246, 0.05)
        ) !important;

    color:
        #60a5fa !important;

}


.sidebar .nav-link.active::before {

    transform:
        scaleY(1);

}


/* =========================================================
   MAIN CONTENT
========================================================= */

main {

    animation:
        dashboardEnter
        0.7s
        ease
        forwards;

}


@keyframes dashboardEnter {

    from {

        opacity: 0;

        transform:
            translateY(15px);

    }

    to {

        opacity: 1;

        transform:
            translateY(0);

    }

}


/* =========================================================
   STATISTICS CARDS
========================================================= */

.card {

    border-radius:
        16px !important;

    border:
        1px solid
        rgba(96, 165, 250, 0.1) !important;

    background:
        linear-gradient(
            145deg,
            rgba(30, 41, 59, 0.95),
            rgba(15, 23, 42, 0.95)
        ) !important;

    box-shadow:
        0 4px 20px
        rgba(0, 0, 0, 0.3) !important;

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease !important;

    overflow: hidden;

}


.card:hover {

    transform:
        translateY(-5px);

    box-shadow:
        0 10px 30px
        rgba(96, 165, 250, 0.15) !important;

    border-color:
        rgba(96, 165, 250, 0.25) !important;

}


/* =========================================================
   STAT ICONS
========================================================= */

.rounded-circle {

    width:
        55px;

    height:
        55px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    transition:
        transform 0.3s ease;

}


.card:hover .rounded-circle {

    transform:
        scale(1.1)
        rotate(5deg);

}


/* =========================================================
   SERVER STATUS
========================================================= */

#server-status {

    position:
        relative;

    display:
        inline-flex;

    align-items:
        center;

    gap:
        8px;

}


/* نقطة الحالة */

#server-status::before {

    content:
        '';

    width:
        10px;

    height:
        10px;

    background-color:
        #10b981;

    border-radius:
        50%;

    display:
        inline-block;

    animation:
        pulse
        1.8s
        infinite;

}


/* =========================================================
   SERVER PULSE
========================================================= */

@keyframes pulse {

    0% {

        transform:
            scale(0.9);

        box-shadow:
            0 0 0 0
            rgba(16, 185, 129, 0.7);

    }

    70% {

        transform:
            scale(1);

        box-shadow:
            0 0 0 8px
            rgba(16, 185, 129, 0);

    }

    100% {

        transform:
            scale(0.9);

        box-shadow:
            0 0 0 0
            rgba(16, 185, 129, 0);

    }

}


/* =========================================================
   TABLE
========================================================= */

.table {

    color:
        #e2e8f0 !important;

    margin-bottom:
        0;

}


.table thead th {

    color:
        #93c5fd;

    font-weight:
        700;

    border-bottom:
        1px solid
        rgba(148, 163, 184, 0.15);

}


.table tbody tr {

    transition:
        background 0.2s ease;

}


.table tbody tr:hover {

    background:
        rgba(59, 130, 246, 0.06);

}


/* =========================================================
   BADGES
========================================================= */

.badge {

    font-family:
        'Cairo',
        sans-serif;

    font-weight:
        600;

    border-radius:
        8px;

}


/* =========================================================
   BUTTONS
========================================================= */

.btn {

    font-family:
        'Cairo',
        sans-serif;

    font-weight:
        600;

    border-radius:
        9px;

    transition:
        all 0.25s ease;

}


.btn-primary {

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #3b82f6
        );

    border:
        none;

    box-shadow:
        0 8px 20px
        rgba(37, 99, 235, 0.25);

}


.btn-primary:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 12px 28px
        rgba(37, 99, 235, 0.4);

}


/* =========================================================
   INPUTS
========================================================= */

.form-control,
.form-select {

    background:
        rgba(15, 23, 42, 0.75) !important;

    border:
        1px solid
        rgba(148, 163, 184, 0.2) !important;

    color:
        #fff !important;

    font-family:
        'Cairo',
        sans-serif;

    border-radius:
        9px;

}


.form-control:focus,
.form-select:focus {

    border-color:
        #3b82f6 !important;

    box-shadow:
        0 0 0 3px
        rgba(59, 130, 246, 0.12) !important;

}


/* =========================================================
   DASHBOARD HEADINGS
========================================================= */

h1,
h2,
h3,
h4,
h5,
h6 {

    font-family:
        'Cairo',
        sans-serif;

    font-weight:
        800;

}


.text-primary {

    color:
        #60a5fa !important;

}


/* =========================================================
   LIVE DATA GLOW
========================================================= */

.live-data {

    animation:
        dataGlow
        2s
        ease-in-out
        infinite
        alternate;

}


@keyframes dataGlow {

    from {

        text-shadow:
            0 0 2px
            rgba(96, 165, 250, 0.1);

    }

    to {

        text-shadow:
            0 0 14px
            rgba(96, 165, 250, 0.45);

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

    .sidebar {

        box-shadow:
            0 5px 20px
            rgba(0, 0, 0, 0.35);

    }


    .card {

        border-radius:
            13px !important;

    }


    .sidebar .nav-link {

        padding:
            10px 15px;

    }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {

        animation-duration:
            0.01ms !important;

        animation-iteration-count:
            1 !important;

        transition-duration:
            0.01ms !important;

    }

}
```

